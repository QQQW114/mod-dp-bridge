  "unsupportedPatterns": [
    {
      "pattern": "method override or anonymous method body",
      "action": "drop behavior, retain public field initializers, mark containing content degraded",
      "diagnostic": "JAVA_METHOD_OVERRIDE_DROPPED"
    },
    {
      "pattern": "lambda assigned to renderer/update/hit/AI/consumer callback",
      "action": "drop or nearest standard fallback",
      "diagnostic": "JAVA_LAMBDA_UNSUPPORTED"
    },
    {
      "pattern": "reflection, arbitrary class loading, file/network/event/UI access",
      "action": "never evaluate or execute; exclude expression/content as appropriate",
      "diagnostic": "JAVA_UNSAFE_CODE_NOT_EXECUTED"
    },
    {
      "pattern": "StatusEffect affinity/opposite transition handler",
      "action": "optionally keep affinities/opposites for display only; report behavior loss",
      "diagnostic": "JAVA_STATUS_TRANSITION_BEHAVIOR_DROPPED"
    },
    {
      "pattern": "consumePowerDynamic/consumePowerCond or predicate-based Consume filters",
      "action": "cannot preserve callback; use fixed declared/displayed value only when explicitly available, otherwise drop consume",
      "diagnostic": "JAVA_DYNAMIC_CONSUMER_DROPPED"
    },
    {
      "pattern": "unresolved constructor argument required for parser initialization",
      "action": "do not emit malformed object; fail that nested object and degrade/fail its owner based on requiredness",
      "diagnostic": "JAVA_EXPRESSION_UNRESOLVED"
    }
  ],
  "reportingContract": {
    "statuses": [
      "converted",
      "degraded",
      "excluded",
      "unsupported",
      "failed"
    ],
    "requiredPerDiagnostic": [
      "code",
      "severity",
      "source path",
      "line/column when known",
      "content kind/name",
      "Java construct",
      "target fallback or omitted field",
      "lost behavior",
      "suggested manual action"
    ],
    "contentRule": "Any emitted content with at least one dropped field, callback, constructor semantic, or fallback class is degraded, never converted.",
    "summaryCounters": [
      "root content discovered",
      "root content emitted",
      "nested objects emitted",
      "promoted content",
      "degraded types",
      "dropped fields",
      "dropped behaviors",
      "unresolved expressions",
      "failed outputs"
    ]
  },
  "safeExpressionSubset": {
    "supported": [
      "string/char/boolean/null/numeric literals",
      "parentheses and primitive casts",
      "unary + - !",
      "constant arithmetic + - * / %",
      "string concatenation",
      "constant ternary",
      "array initializer",
      "static final constants whose initializer is in the parsed source graph",
      "known content/static field references",
      "known constructor/factory/builder mappings"
    ],
    "colorChains": {
      "cpy": "copy",
      "set(color)": "replace with color",
      "a(alpha)": "replace alpha",
      "mul(scalar)": "multiply rgba channels using target Color semantics",
      "lerp(color,t)": "linear interpolate rgba"
    },
    "boundedControlFlow": {
      "for": "expand only statically bounded integer/enhanced loops; enforce an expansion limit and record each generated element source location",
      "knownIterables": {
        "Mathf.signs": [
          -1,
          1
        ]
      },
      "if": "execute only when condition is statically boolean; otherwise report both affected statements as unsupported",
      "locals": "support final/effectively-final locals and loop-index-derived arithmetic"
    },
    "helperMethods": {
      "SFireMod.name(x)": "sourceNamespace + \"-\" + x (keep SOURCE namespace; shared rewriter handles member names)",
      "simple pure copy helpers": "allow only explicitly registered helpers such as copyRotate/copyRotRel; never execute their Java body"
    },
    "prohibited": [
      "reflection",
      "class loading",
      "I/O",
      "network",
      "events",
      "UI",
      "threads",
      "native calls",
      "arbitrary method calls",
      "runtime world/game state"
    ]
  },
  "parserFailureGuards": [
    {
      "object": "StatusFieldAbility",
      "guard": "constructor effect must be emitted; null effect fails ContentParser.checkNullFields"
    },
    {
      "object": "ItemStack",
      "guard": "item and amount must be emitted; never serialize as {type:ItemStack} without item"
    },
    {
      "object": "LiquidStack",
      "guard": "liquid and amount must be emitted; never serialize alternating raw values as LiquidStack[]"
    },
    {
      "object": "UnitPlan",
      "guard": "unit, time and requirements must be emitted"
    },
    {
      "object": "Ability",
      "guard": "type is mandatory and must resolve through ClassMap; required non-null fields from constructor must be lowered"
    },
    {
      "object": "inline UnlockableContent",
      "guard": "promote to root content; DataPatcher rejects inline creation"
    },
    {
      "object": "root Block type",
      "guard": "must be an effective ClassMap short name with String constructor; unknown custom type is a hard asset error because allowClassResolution=false"
    },
    {
      "object": "unit template",
      "guard": "must resolve through ClassMap; unknown names fall back with warning and must be reported as degradation before validation"
    },
    {
      "object": "Effect lambda",
      "guard": "do not emit type Effect; Effect is not a ClassMap entry and fallback-to-ParticleEffect warnings are not fidelity"
    },
    {
      "object": "Weapon.name",
      "guard": "keep source member naming until namespace rewrite; emitting dp-* before ContentParser produces dp-dp-*"
    },
    {
      "object": "addAll",
      "guard": "flatten collection/array argument; nested arrays usually fail element parsing"
    },
    {
      "object": "map factories",
      "guard": "ObjectMap.of/OrderedMap.of/ammo alternating pairs must become JSON object maps, never arrays"
    }
  ]
}
