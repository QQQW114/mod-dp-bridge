{
  "schemaVersion": 1,
  "target": {
    "mindustryVersion": "v159.7",
    "buildLine": "B480",
    "dataPatchFormatVersion": 2,
    "classMapFile": "config/mindustry-v1597-classmap.json"
  },
  "sourceOfTruth": {
    "contentParser": "core/src/mindustry/mod/ContentParser.java",
    "dataPatcher": "core/src/mindustry/mod/DataPatcher.java",
    "classMap": "core/src/mindustry/mod/ClassMap.java"
  },
  "runtimeBoundary": {
    "allowedRootContentKinds": [
      "item",
      "block",
      "liquid",
      "status",
      "unit",
      "weather"
    ],
    "excludedByProductPolicy": [
      "planet",
      "sector",
      "tech-tree",
      "map-generation",
      "GUI",
      "network"
    ],
    "allowClassResolution": false,
    "rule": "A target type must resolve by effective ClassMap short name and be assignable in the parser context. FQCN/custom classes are never emitted.",
    "unknownFields": "ContentParser warns and ignores them; converter must pre-report every dropped/unknown field instead of treating load success as full success."
  },
  "namespacePolicy": {
    "recommendedStaticOutputNamespace": "SOURCE",
    "reason": "Existing ModNamespaceRewriter must turn content/asset refs into dp-* while stripping the source prefix from nested member names. Weapon parser itself prefixes dp-, so TARGET name values can become dp-dp-*.",
    "rootAssetBasename": "local Java content name without source mod namespace",
    "contentReference": "emit source-qualified or local source name; rewriter emits dp-local",
    "nestedMappableName": "emit original Java value; rewriter strips exactly one sourceMod- prefix and ContentParser adds dp-",
    "mapCompatibility": "source maps storing sourceMod-local content names require a separate sourceMod-local -> dp-local rewrite/migration table."
  },
  "rootResolution": {
    "exactTypes": {
      "Item": {
        "fqcn": "mindustry.type.Item",
        "rootKind": "item",
        "outputDir": "content/items",
        "targetType": null,
        "nameRule": "arg[0]",
        "constructors": [
          {
            "params": [
              "name"
            ]
          },
          {
            "params": [
              "name",
              "color"
            ],
            "fields": [
              null,
              "color"
            ]
          }
        ]
      },
      "Liquid": {
        "fqcn": "mindustry.type.Liquid",
        "rootKind": "liquid",
        "outputDir": "content/liquids",
        "targetType": null,
        "nameRule": "arg[0]",
        "constructors": [
          {
            "params": [
              "name"
            ]
          },
          {
            "params": [
              "name",
              "color"
            ],
            "fields": [
              null,
              "color"
            ]
          }
        ]
      },
      "CellLiquid": {
        "fqcn": "mindustry.type.CellLiquid",
        "rootKind": "liquid",
        "outputDir": "content/liquids",
        "targetType": "CellLiquid",
        "rootSelector": "type",
        "nameRule": "arg[0]",
        "constructors": [
          {
            "params": [
              "name"
            ]
          },
          {
            "params": [
              "name",
              "color"
            ],
            "fields": [
              null,
              "color"
            ]
          }
        ]
      },
      "StatusEffect": {
        "fqcn": "mindustry.type.StatusEffect",
        "rootKind": "status",
        "outputDir": "content/statuses",
        "targetType": null,
        "nameRule": "arg[0]",
        "constructors": [
          {
            "params": [
              "name"
            ]
          }
        ]
      },
      "UnitType": {
        "fqcn": "mindustry.type.UnitType",
        "rootKind": "unit",
        "outputDir": "content/units",
        "targetType": null,
        "rootSelector": "template",
        "nameRule": "arg[0]",
        "constructors": [
          {
            "params": [
              "name"
            ]
          }
        ]
      },
      "TankUnitType": {
