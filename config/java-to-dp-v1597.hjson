  "builderMappings": {
    "requirements": {
      "receiver": "Block",
      "overloads": [
        {
          "params": [
            "category",
            "requirements"
          ],
          "writes": {
            "category": "arg[0]",
            "requirements": "flattenStacks(arg[1])",
            "buildVisibility": "shown"
          }
        },
        {
          "params": [
            "category",
            "visibility",
            "requirements"
          ],
          "writes": {
            "category": "arg[0]",
            "buildVisibility": "arg[1]",
            "requirements": "flattenStacks(arg[2])"
          }
        },
        {
          "params": [
            "category",
            "requirements",
            "unlocked"
          ],
          "writes": {
            "category": "arg[0]",
            "requirements": "flattenStacks(arg[1])",
            "buildVisibility": "shown",
            "alwaysUnlocked": "arg[2]"
          }
        }
      ]
    },
    "consumePower": {
      "receiver": "Block",
      "params": [
        "usage"
      ],
      "writesPath": "consumes.power",
      "value": "arg[0]"
    },
    "consumePowerBuffered": {
      "receiver": "Block",
      "params": [
        "capacity"
      ],
      "writesPath": "consumes.powerBuffered",
      "value": "arg[0]"
    },
    "consumeItem": {
      "receiver": "Block",
      "overloads": [
        {
          "params": [
            "item"
          ],
          "writesPath": "consumes.items",
          "value": "[{item: arg[0], amount: 1}]"
        },
        {
          "params": [
            "item",
            "amount"
          ],
          "writesPath": "consumes.items",
          "value": "[{item: arg[0], amount: arg[1]}]"
        }
      ]
    },
    "consumeItems": {
      "receiver": "Block",
      "params": [
        "items..."
      ],
      "writesPath": "consumes.items",
      "value": "flattenStacks(args)"
    },
    "consumeLiquid": {
      "receiver": "Block",
      "params": [
        "liquid",
        "amount"
      ],
      "writesPath": "consumes.liquid",
      "value": "{liquid:arg[0], amount:arg[1]}"
    },
    "consumeLiquids": {
      "receiver": "Block",
      "params": [
        "liquids..."
      ],
      "writesPath": "consumes.liquids",
      "value": "flattenStacks(args)"
    },
    "consumeCoolant": {
      "receiver": "Block",
      "overloads": [
        {
          "params": [
            "amount"
          ],
          "writesPath": "consumes.coolant",
          "value": "{amount:arg[0]}"
        },
        {
          "params": [
            "amount",
            "allowLiquid",
            "allowGas"
          ],
          "writesPath": "consumes.coolant",
          "value": "{amount:arg[0], allowLiquid:arg[1], allowGas:arg[2]}"
        }
      ]
    },
    "consume": {
      "receiver": "Block",
      "params": [
        "consumeObject"
      ],
      "writesPath": "consumes.<key-derived-from-Consume-subclass>",
      "value": "serializeConsume(arg[0])"
    },
    "boost": {
      "receiver": "Consume",
      "chainWrites": {
        "optional": true,
        "booster": true
      }
    },
    "optional": {
      "receiver": "Consume",
      "params": [
        "optional",
        "booster"
      ],
      "chainWrites": {
        "optional": "arg[0]",
        "booster": "arg[1]"
      }
    },
    "update": {
      "receiver": "Consume",
      "params": [
        "update"
      ],
      "chainWrites": {
        "update": "arg[0]"
      }
    },
    "ammo": {
      "receiver": "ItemTurret|LiquidTurret|ContinuousLiquidTurret|PayloadAmmoTurret",
      "params": [
        "key,value..."
      ],
      "writes": "ammoTypes",
      "value": "alternatingPairsToMap(args)"
    },
    "add": {
      "receiver": "Seq|ObjectSet",
      "params": [
        "value"
      ],
      "writes": "receiverField",
      "mode": "append"
    },
    "addAll": {
      "receiver": "Seq|ObjectSet",
      "params": [
        "values..."
      ],
      "writes": "receiverField",
      "mode": "append-all"
    },
    "put": {
      "receiver": "ObjectMap|ObjectFloatMap|ObjectIntMap",
      "params": [
        "key",
        "value"
      ],
      "writes": "receiverField",
      "mode": "map-put"
    },
    "putAll": {
      "receiver": "ObjectMap|ObjectFloatMap|ObjectIntMap",
      "params": [
        "map"
      ],
      "writes": "receiverField",
      "mode": "map-merge"
    },
    "set": {
      "receiver": "Attributes",
      "params": [
        "attribute",
        "value"
      ],
      "writes": "receiverField",
      "mode": "attribute-put",
      "key": "staticFieldName(arg[0])"
    },
    "setEnginesMirror": {
      "receiver": "UnitType",
      "params": [
        "engines..."
      ],
      "writes": "engines",
      "mode": "append-expanded",
      "expand": "for each {x,y,radius,rotation}, append original and {x:-x,y,radius,rotation:normalize360(180-rotation)}"
    },
    "opposite": {
      "receiver": "StatusEffect",
      "params": [
        "statuses..."
      ],
      "writes": "opposites",
      "mode": "append-all",
      "fidelity": "display-only",
      "diagnostic": "JAVA_STATUS_TRANSITION_BEHAVIOR_DROPPED"
    },
    "affinity": {
      "receiver": "StatusEffect",
      "params": [
        "status",
        "handler"
      ],
      "writes": "affinities",
      "mode": "append",
      "fidelity": "display-only; handler cannot be represented",
      "diagnostic": "JAVA_STATUS_TRANSITION_BEHAVIOR_DROPPED"
    },
    "copy": {
      "receiver": "IR object",
      "params": [],
      "result": "deepCopy(receiver)",
      "condition": "receiver object graph is already statically known"
    },
    "copyRotate": {
      "receiver": "SFUnitTypes helper",
      "params": [
        "weapon",
        "x",
        "y",
        "baseRotation"
      ],
      "result": "deepCopy(arg[0]) then set x/y/baseRotation"
    },
    "copyRotRel": {
      "receiver": "SFUnitTypes helper",
      "params": [
        "weapon",
        "x",
        "y",
        "baseRotation",
        "reloadOffset"
      ],
      "result": "deepCopy(arg[0]) then set x/y/baseRotation and reload += reloadOffset"
    }
  },
  "staticFactories": {
    "ItemStack.with|with": {
      "shape": "alternating item,amount pairs",
      "result": "ItemStack[]"
    },
    "LiquidStack.with": {
      "shape": "alternating liquid,amount pairs",
      "result": "LiquidStack[]"
    },
    "ItemStack.mult": {
      "params": [
        "baseStacks",
        "multiplier"
      ],
      "result": "copy stacks and amount = Mathf.round(originalAmount * multiplier)",
      "condition": "baseStacks must be statically known; otherwise diagnostic JAVA_EXPRESSION_UNRESOLVED"
    },
    "Seq.with": {
      "result": "array(args)"
    },
    "ObjectSet.with": {
      "result": "uniqueArray(args)"
    },
    "ObjectMap.of|OrderedMap.of": {
      "shape": "alternating key,value pairs",
      "result": "map"
    },
    "Color.valueOf": {
      "result": "normalized RGBA hex string"
    },
    "Sounds.<field>": {
      "result": "sound field name as string"
    },
    "Fx.<field>": {
      "result": "effect field name as string"
    },
    "Interp.<field>": {
      "result": "interp field name as string"
    },
    "Blending.<field>": {
      "result": "blending field name as string"
    },
    "CacheLayer.<field>": {
      "result": "cache layer field name as string"
    },
    "BuildVisibility.<field>": {
      "result": "visibility field name as string"
    },
    "Category.<field>": {
      "result": "category field name as string"
    },
    "Attribute.<field>": {
      "result": "attribute field name as string"
    },
    "SFSounds.loadSound|Vars.tree.loadSound": {
      "params": [
        "assetName"
      ],
      "result": "source asset name; namespace rewriter converts to dp-*"
    }
  },
  "partProgress": {
    "constants": [
      "reload",
      "smoothReload",
      "warmup",
      "charge",
      "recoil",
      "smoothRecoil",
      "heat",
      "life",
      "time",
      "sin",
      "reloadWarmup"
    ],
    "emit": {
      "single": "string constant",
      "chain": "{type:<base>, operations:[...]}"
    },
    "operations": {
      "inv": [],
      "slope": [],
      "clamp": [],
      "delay": [
        "amount"
      ],
      "sustain": [
        "offset",
        "grow",
        "sustain"
      ],
      "shorten": [
        "amount"
      ],
      "compress": [
        "start",
        "end"
      ],
      "add": [
        "amount-or-other"
      ],
      "blend": [
        "other",
        "amount"
      ],
      "mul": [
        "amount-or-other"
      ],
      "min": [
        "other"
      ],
      "sin": [
        "offset",
        "scl",
        "mag"
      ],
      "absin": [
        "scl",
        "mag"
      ],
      "mod": [
        "amount"
      ],
      "loop": [
        "time"
      ],
      "curve": [
        "interp OR offset,duration"
      ]
    }
  },
  "unitEntityAndControllerMappings": {
    "methodReferences": {
      "UnitEntity::create": "flying",
      "MechUnit::create": "mech",
      "LegsUnit::create": "legs",
      "UnitWaterMove::create": "naval",
      "PayloadUnit::create": "payload",
      "TimedKillUnit::create": "missile",
      "TankUnit::create": "tank",
      "ElevationMoveUnit::create": "hover",
      "BuildingTetherPayloadUnit::create": "tether",
      "CrawlUnit::create": "crawl"
    },
    "javaAssignments": {
      "constructor = UnitTypes.<name>.constructor": "look up trusted v159.7 EntityMapping catalog, then emit unit root field type",
      "constructor = EntityMapping.map(<constant>)": "look up trusted v159.7 ID catalog, then emit unit root field type",
      "aiController = <AI>::new": "emit aiController: <ClassMap short name>",
      "controller = u -> new <AI>()": "emit defaultController: <ClassMap short name>"
    },
    "saturationReferencedVanillaCatalog": {
      "flare": "flying",
      "elude": "hover",
      "corvus": "legs",
      "zenith": "flying",
      "reign": "mech",
      "omura": "naval",
      "oct": "payload",
      "eclipse": "flying",
      "stell": "tank",
      "quad": "payload",
      "risso": "naval",
      "mega": "payload",
      "dagger": "mech",
      "atrax": "legs",
      "gamma": "flying",
      "assembly-drone": "tether",
      "EntityMapping.map(3)": "flying"
    }
  },
  "inlineContentPromotion": {
    "match": "new Item/Liquid/StatusEffect/UnitType subclass appears inside another content object",
    "rule": "emit it as its own root content file, add dependency edge, replace inline value with a content reference",
    "requiredFor": [
      "BulletType.spawnUnit and similar UnitType fields"
    ],
    "diagnostic": "JAVA_CONTENT_PROMOTED",
    "forbidden": "Never emit an inline UnlockableContent object; DataPatcher rejects new content instantiated in a field."
  },
  "effectFallback": {
    "anonymousEffectOrLambda": "replace with string none unless a dedicated deterministic recognizer maps it to ParticleEffect/WaveEffect/ExplosionEffect",
    "customEffectFactory": "replace with none and report the method/factory; do not guess arbitrary renderer behavior",
    "standardEffectClasses": "preserve public fields and known Effect chain setters startDelay/followParent/rotWithParent/layer/baseRotation",
    "diagnostic": "JAVA_LAMBDA_UNSUPPORTED"
  },
  "explicitDegradations": {
    "SFire.expand.blocks.EnhancedPowerTurret": {
      "simpleName": "EnhancedPowerTurret",
      "targetType": "PowerTurret",
      "rootKind": "block",
      "strategy": "nearest-ClassMap-parent",
      "preserveFields": "all fields valid on PowerTurret, especially shootType and standard Turret fields",
      "dropFields": [
        "enhancerItem",
        "enhancedBullet",
        "enhancedPattern",
        "maxEnhanced"
      ],
      "lostBehavior": [
        "item-based enhanced ammo buffer",
        "enhanced bullet selection",
        "enhanced shoot pattern",
        "custom ammo bar/stats"
      ],
      "severity": "error"
    },
    "SFire.expand.blocks.ExplodeWall": {
      "simpleName": "ExplodeWall",
      "targetType": "Wall",
      "rootKind": "block",
      "strategy": "semantic-wall-fallback",
      "preserveFields": [
        "health",
        "armor",
        "size",
        "requirements",
        "category",
        "destroyEffect",
        "buildCostMultiplier",
        "crushDamageMultiplier",
        "flags",
        "priority"
      ],
      "injectConstructorFields": {
        "solid": true,
        "destructible": true,
        "canOverdrive": false,
        "drawDisabled": false,
        "buildCostMultiplier": 4,
