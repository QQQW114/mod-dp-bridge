      "Weather": {
        "fqcn": "mindustry.type.Weather",
        "rootKind": "weather",
        "outputDir": "content/weathers",
        "targetType": "Weather",
        "rootSelector": "type",
        "nameRule": "arg[0]",
        "policy": "supported-by-DP-but-not-a-priority"
      },
      "Floor": {
        "fqcn": "mindustry.world.blocks.environment.Floor",
        "rootKind": "block",
        "outputDir": "content/blocks",
        "targetType": "Floor",
        "rootSelector": "type",
        "nameRule": "arg[0]",
        "constructors": [
          {
            "params": [
              "name"
            ]
          },
          {
            "params": [
              "name",
              "variants"
            ],
            "fields": [
              null,
              "variants"
            ]
          }
        ]
      },
      "OreBlock": {
        "fqcn": "mindustry.world.blocks.environment.OreBlock",
        "rootKind": "block",
        "outputDir": "content/blocks",
        "targetType": "OreBlock",
        "rootSelector": "type",
        "constructors": [
          {
            "params": [
              "name"
            ],
            "nameRule": "arg[0]"
          },
          {
            "params": [
              "name",
              "ore"
            ],
            "fields": [
              null,
              "itemDrop"
            ],
            "nameRule": "arg[0]",
            "derivedFields": {
              "localizedName": "copy ore localized bundle when statically known",
              "mapColor": "copy ore color when statically known",
              "useColor": true,
              "variants": 3
            }
          },
          {
            "params": [
              "ore"
            ],
            "fields": [
              "itemDrop"
            ],
            "nameRule": "\"ore-\" + contentLocalName(arg[0])",
            "derivedFields": {
              "localizedName": "copy ore localized bundle when statically known",
              "mapColor": "copy ore color when statically known",
              "useColor": true,
              "variants": 3
            }
          }
        ]
      }
    },
    "blockFamilyRule": {
      "match": "constructed type is ClassMap-resolvable, assignable to mindustry.world.Block, and exposes a String constructor",
      "rootKind": "block",
      "outputDir": "content/blocks",
      "rootSelector": "type",
      "targetType": "ClassMap short name",
      "nameRule": "String constructor argument; additional constructor arguments must be lowered to fields"
    },
    "customSubclassRule": "use explicitDegradations first; otherwise walk source superclass chain to nearest ClassMap type with the required parser constructor; if no safe parent exists, do not emit content."
  },
