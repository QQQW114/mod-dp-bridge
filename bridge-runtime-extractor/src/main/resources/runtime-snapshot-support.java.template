/**
 * Compiled against the exact user-supplied Mindustry JAR.
 *
     * <p>This encoder reads either a small fixed target-owned field whitelist, or (for UnitType and
     * Block roots) a pristine target-owned field schema frozen before Mod content loading for the
     * selected canonical ClassMap fallback. It never discovers fields from a Mod runtime subclass and never calls Mod
 * getters, {@code equals()}, {@code toString()} or arbitrary serializers. Unsupported objects are
 * represented as explicit opaque values instead of being recursively traversed.</p>
 */
final class RuntimeSnapshotSupport {
    private static final long DEFAULT_MAX_TOTAL_SNAPSHOT_BYTES = 256L * 1024L * 1024L;
    private static final int MAX_ROOT_SNAPSHOT_BYTES = 8 * 1024 * 1024;
    private static final int MAX_DECLARATION_ROWS = 1_024;
    private static final int MAX_METADATA_TEXT = 1_024;
    private static final int MAX_ANCESTRY_DEPTH = 256;
    private static final int MAX_CONTAINER_ITEMS = 4_096;
    private static final long maxTotalSnapshotBytes = positiveLongProperty(
        "moddpbridge.runtimeMaxSnapshotBytes",
        DEFAULT_MAX_TOTAL_SNAPSHOT_BYTES
    );

