package bridgeprobe;

import mindustry.Vars;
import mindustry.core.ContentLoader;
import mindustry.ctype.Content;
import mindustry.ctype.MappableContent;
import mindustry.mod.Plugin;

import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardOpenOption;
import java.util.Base64;
import java.util.Collections;
import java.util.IdentityHashMap;
import java.util.Map;

/** Compiled against the exact user-supplied Mindustry server JAR at extraction time. */
public class RuntimeTraceProbe extends Plugin {
    private static final Map<Content, StackTraceElement[]> traces =
        Collections.synchronizedMap(new IdentityHashMap<>());
    private static final String targetMod = System.getProperty("moddpbridge.runtimeTargetMod", "");
    private static final Path traceFile = propertyPath("moddpbridge.runtimeTraceFile");
    private static final Path phaseFile = propertyPath("moddpbridge.runtimePhaseFile");
    private static final Path statusFile = propertyPath("moddpbridge.runtimeTrackerStatusFile");
    private static final Path preContentInitSnapshotFile = propertyPath("moddpbridge.runtimePreContentInitSnapshotFile");
    private static final Path postContentInitSnapshotFile = propertyPath("moddpbridge.runtimePostContentInitSnapshotFile");
    private static final Path finalSnapshotFile = propertyPath("moddpbridge.runtimeFinalSnapshotFile");
    private static final Path vanillaPhaseFile = optionalPropertyPath("moddpbridge.runtimeVanillaPhaseFile");
    private static final Path vanillaBeforeModContentFile =
        optionalPropertyPath("moddpbridge.runtimeVanillaBeforeModContentFile");
    private static final Path vanillaPreContentInitFile =
        optionalPropertyPath("moddpbridge.runtimeVanillaPreContentInitFile");
    private static final Path vanillaPostContentInitFile =
        optionalPropertyPath("moddpbridge.runtimeVanillaPostContentInitFile");
    private static final Path vanillaFinalFile = optionalPropertyPath("moddpbridge.runtimeVanillaFinalFile");
    private static boolean finalSnapshotWritten;

    public RuntimeTraceProbe() {
        try {
            RuntimeSnapshotSupport.initializeTrustedMetadata();
            if (Vars.content == null) {
                refuse("Vars.content was null before tracker installation.");
            }
            if (!RuntimeSnapshotSupport.registryIsEmpty()) {
                refuse("Content registry was not empty before tracker installation.");
            }
            Vars.content = new TrackingContentLoader();
            write(statusFile, "installed\n");
            System.out.println("DPBRIDGE_TRACKER\tINSTALLED");
        } catch (RuntimeException error) {
            throw error;
        } catch (Exception error) {
            throw new RuntimeException("Could not install runtime ContentLoader tracker.", error);
        }
    }

    private static final class TrackingContentLoader extends ContentLoader {
        @Override
        public void handleContent(Content content) {
            super.handleContent(content);
            if (!(content instanceof MappableContent)) {
                traces.put(content, Thread.currentThread().getStackTrace());
            }
        }

        @Override
        public void handleMappableContent(MappableContent content) {
            super.handleMappableContent(content);
            traces.put(content, Thread.currentThread().getStackTrace());
        }

        /**
         * Captures the pristine target content baseline immediately before any Mod content is created,
         * while no Mod code has been able to mutate target content yet. {@code Mod#loadContent()} - and
         * therefore every load-time content override - runs inside this call, so the baseline cannot be
         * taken from any later phase.
         */
        @Override
        public void createModContent() {
            writeVanilla(vanillaBeforeModContentFile, "BEFORE_MOD_CONTENT", "VANILLA_BEFORE_MOD_CONTENT");
            super.createModContent();
        }

        @Override
        public void init() {
            int preInit = writeSnapshot(preContentInitSnapshotFile, "PRE_CONTENT_INIT");
            append(phaseFile, "PRE_CONTENT_INIT\t" + preInit + "\n");
            System.out.println("DPBRIDGE_PHASE\tPRE_CONTENT_INIT\t" + preInit);
            writeVanilla(vanillaPreContentInitFile, "PRE_CONTENT_INIT", "VANILLA_PRE_CONTENT_INIT");
            super.init();
            int postInit = writeSnapshot(postContentInitSnapshotFile, "POST_CONTENT_INIT");
            append(phaseFile, "POST_CONTENT_INIT\t" + postInit + "\n");
            System.out.println("DPBRIDGE_PHASE\tPOST_CONTENT_INIT\t" + postInit);
            writeVanilla(vanillaPostContentInitFile, "POST_CONTENT_INIT", "VANILLA_POST_CONTENT_INIT");
        }
    }

    /**
     * Called reflectively by the worker from ServerLoadEvent, after every Mod.init() has completed.
     */
    public synchronized void captureFinalAfterModInit() {
        if (finalSnapshotWritten) return;
        int count = writeSnapshot(finalSnapshotFile, "FINAL_AFTER_MOD_INIT");
        append(phaseFile, "FINAL_AFTER_MOD_INIT\t" + count + "\n");
        writeVanilla(vanillaFinalFile, "FINAL_AFTER_MOD_INIT", "VANILLA_FINAL_AFTER_MOD_INIT");
        writeTraces();
        finalSnapshotWritten = true;
        System.out.println("DPBRIDGE_PHASE\tFINAL_AFTER_MOD_INIT\t" + count);
    }

    private static void writeVanilla(Path file, String phase, String marker) {
        if (file == null) return;
        try {
            int count = RuntimeSnapshotSupport.writeVanillaWatch(file, phase, vanillaPhaseFile, marker);
            System.out.println("DPBRIDGE_VANILLA\t" + marker + "\t" + count);
        } catch (Exception error) {
            throw new RuntimeException("Could not capture the vanilla watch snapshot for phase " + phase + ".", error);
        }
    }

    private static int writeSnapshot(Path file, String phase) {
        try {
            return RuntimeSnapshotSupport.write(file, targetMod, phase);
        } catch (Exception error) {
            throw new RuntimeException("Could not freeze runtime snapshot for phase " + phase + ".", error);
        }
    }

    private static void writeTraces() {
        StringBuilder output = new StringBuilder();
        for (Content content : RuntimeSnapshotSupport.targetContents(targetMod)) {
                String name = RuntimeSnapshotSupport.contentName(content);
                StackTraceElement[] stack = traces.get(content);
                StringBuilder rendered = new StringBuilder();
                if (stack != null) {
                    for (StackTraceElement frame : stack) {
                        String className = frame.getClassName();
                        if (className.equals(Thread.class.getName()) || className.startsWith("bridgeprobe.")) continue;
                        rendered.append(frame).append('\n');
                    }
                }
                output.append(encode(RuntimeSnapshotSupport.contentTypeName(content))).append('\t')
                    .append(encode(name)).append('\t')
                    .append(encode(rendered.toString())).append('\n');
        }
        try {
            write(traceFile, output.toString());
        } catch (Exception error) {
            throw new RuntimeException("Could not write runtime registration traces.", error);
        }
    }

    private static void refuse(String reason) throws Exception {
        write(statusFile, "refused: " + reason + "\n");
        System.err.println("DPBRIDGE_TRACKER\tREFUSED\t" + reason);
        throw new IllegalStateException(reason);
    }

    private static Path propertyPath(String name) {
        String value = System.getProperty(name);
        if (value == null || value.isBlank()) throw new IllegalStateException("Missing system property " + name);
        return Path.of(value).toAbsolutePath().normalize();
    }

    /** Vanilla watch capture is optional; an absent property disables the whole vanilla watch feature. */
    private static Path optionalPropertyPath(String name) {
        String value = System.getProperty(name);
        if (value == null || value.isBlank()) return null;
        return Path.of(value).toAbsolutePath().normalize();
    }

    private static void write(Path path, String value) throws Exception {
        Files.createDirectories(path.getParent());
        Files.writeString(path, value, StandardCharsets.UTF_8);
    }

    private static void append(Path path, String value) {
        try {
            Files.createDirectories(path.getParent());
            Files.writeString(
                path,
                value,
                StandardCharsets.UTF_8,
                StandardOpenOption.CREATE,
                StandardOpenOption.APPEND
            );
        } catch (Exception error) {
            throw new RuntimeException("Could not write runtime phase marker.", error);
        }
    }

    private static String encode(String value) {
        return Base64.getUrlEncoder().withoutPadding().encodeToString(value.getBytes(StandardCharsets.UTF_8));
    }
}
